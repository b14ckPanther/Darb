{
  "name": "darb-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant, multi-product business platform for the Israeli market.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "db:lint": "supabase db lint --local --level warning",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "pnpm --filter @darb/database generate:types",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint playwright.config.ts scripts tests && turbo run lint",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "test": "turbo run test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@darb/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
