# Browser-visible configuration. The publishable key remains subject to RLS and is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://xtuhwpyqxgmsthgumktk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only and required only for trusted DNS/provider attestation operations. Never expose this
# value to browser code; ordinary tenant administration uses the authenticated request client.
SUPABASE_SECRET_KEY=

# Server-only custom-domain deployment provider. Production uses Vercel's official project-domain
# APIs and are needed only when domain deployment management is used. Team ID is optional for
# personal projects. Never expose these values to browser code.
DARB_VERCEL_API_TOKEN=
DARB_VERCEL_RESTAURANT_PROJECT_ID=
DARB_VERCEL_TEAM_ID=

# Local/E2E-only deterministic provider; production rejects this mode.
# DARB_DOMAIN_PROVIDER=fake
# DARB_FAKE_DOMAIN_PROVIDER_STATE=live
